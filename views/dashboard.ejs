<%- include('layout/header') %>

<style>
    .dashboard-container {
        max-width: 1200px;
        margin: 35px auto;
        padding: 0 20px;
    }

    .welcome-section {
        margin-bottom: 28px;
    }

    .welcome-section h1 {
        font-size: 30px;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .welcome-section p {
        color: #777;
        margin: 0;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #e2e2e2;
        border-radius: 8px;
        padding: 22px;
        height: 100%;
    }

    .stat-title {
        color: #777;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .stat-value {
        font-size: 27px;
        font-weight: 600;
        margin: 0;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0f2f5;
        color: #333;
        font-size: 19px;
    }

    .section-card {
        background: #fff;
        border: 1px solid #e2e2e2;
        border-radius: 8px;
        padding: 22px;
        height: 100%;
    }

    .section-title {
        font-size: 19px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .menu-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 13px 0;
        border-bottom: 1px solid #eeeeee;
    }

    .menu-row:last-child {
        border-bottom: none;
    }

    .menu-name {
        font-weight: 500;
    }

    .menu-category {
        color: #888;
        font-size: 13px;
        margin-top: 3px;
    }

    .menu-price {
        font-weight: 600;
    }

    .status {
        font-size: 12px;
        padding: 5px 9px;
        border-radius: 4px;
    }

    .available {
        background: #e9f7ef;
        color: #218838;
    }

    .low-stock {
        background: #fff4e5;
        color: #b36b00;
    }

    .quick-link {
        display: block;
        text-decoration: none;
        color: #333;
        border: 1px solid #e4e4e4;
        border-radius: 6px;
        padding: 13px 15px;
        margin-bottom: 10px;
        transition: 0.2s;
    }

    .quick-link:hover {
        background: #f7f7f7;
        color: #111;
    }

    .quick-link i {
        margin-right: 10px;
    }

    .insight-box {
        background: #f7f8fa;
        border-left: 4px solid #333;
        padding: 15px;
        line-height: 1.6;
        color: #555;
    }

    @media (max-width: 768px) {
        .dashboard-container {
            margin-top: 20px;
        }
    }
</style>


<div class="dashboard-container">

    <!-- Page Heading -->

    <div class="welcome-section">
        <h1>Dashboard</h1>
        <p>Overview of your cafe operations</p>
    </div>


    <!-- Statistics -->

    <div class="row g-4 mb-4">

        <!-- Revenue -->

        <div class="col-md-3">
            <div class="stat-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <div class="stat-title">
                            Today's Revenue
                        </div>

                        <p class="stat-value">
                            ₹<%= typeof revenue !== 'undefined' ? revenue : 0 %>
                        </p>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-currency-rupee"></i>
                    </div>

                </div>

            </div>
        </div>


        <!-- Orders -->

        <div class="col-md-3">
            <div class="stat-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <div class="stat-title">
                            Total Orders
                        </div>

                        <p class="stat-value">
                            <%= typeof orders !== 'undefined' ? orders : 0 %>
                        </p>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-receipt"></i>
                    </div>

                </div>

            </div>
        </div>


        <!-- Menu -->

        <div class="col-md-3">
            <div class="stat-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <div class="stat-title">
                            Menu Items
                        </div>

                        <p class="stat-value">
                            <%= typeof menuCount !== 'undefined' ? menuCount : 0 %>
                        </p>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-list-ul"></i>
                    </div>

                </div>

            </div>
        </div>


        <!-- Customers -->

        <div class="col-md-3">
            <div class="stat-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <div class="stat-title">
                            Customers
                        </div>

                        <p class="stat-value">
                            <%= typeof customers !== 'undefined' ? customers : 0 %>
                        </p>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-people"></i>
                    </div>

                </div>

            </div>
        </div>

    </div>


    <!-- Menu Overview + Quick Actions -->

    <div class="row g-4">

        <!-- Menu Overview -->

        <div class="col-md-7">

            <div class="section-card">

                <div class="section-title">
                    Menu Overview
                </div>


                <% if (typeof menuItems !== 'undefined' && menuItems.length > 0) { %>

                    <% menuItems.slice(0, 5).forEach(function(item) { %>

                        <div class="menu-row">

                            <div>

                                <div class="menu-name">
                                    <%= item.name %>
                                </div>

                                <div class="menu-category">
                                    <%= item.category %>
                                </div>

                            </div>

                            <div class="menu-price">
                                ₹<%= item.price %>
                            </div>

                        </div>

                    <% }); %>

                <% } else { %>

                    <p class="text-muted">
                        No menu items available.
                    </p>

                <% } %>

            </div>

        </div>


        <!-- Quick Actions -->

        <div class="col-md-5">

            <div class="section-card">

                <div class="section-title">
                    Quick Actions
                </div>


                <a href="/add" class="quick-link">
                    <i class="bi bi-plus-circle"></i>
                    Add New Menu Item
                </a>


                <a href="/index" class="quick-link">
                    <i class="bi bi-pencil-square"></i>
                    Manage Menu
                </a>


                <a href="/orders" class="quick-link">
                    <i class="bi bi-receipt"></i>
                    View Orders
                </a>


                <a href="/inventory" class="quick-link">
                    <i class="bi bi-box-seam"></i>
                    Manage Inventory
                </a>


                <a href="/analytics" class="quick-link">
                    <i class="bi bi-bar-chart"></i>
                    View Analytics
                </a>

            </div>

        </div>

    </div>


    <!-- Inventory + Business Insight -->

    <div class="row g-4 mt-1">

        <!-- Inventory -->

        <div class="col-md-6">

            <div class="section-card">

                <div class="section-title">
                    Inventory Status
                </div>


                <div class="menu-row">

                    <div>
                        <div class="menu-name">
                            Coffee Beans
                        </div>

                        <div class="menu-category">
                            Raw Material
                        </div>
                    </div>

                    <span class="status available">
                        Available
                    </span>

                </div>


                <div class="menu-row">

                    <div>
                        <div class="menu-name">
                            Milk
                        </div>

                        <div class="menu-category">
                            Dairy
                        </div>
                    </div>

                    <span class="status low-stock">
                        Low Stock
                    </span>

                </div>


                <div class="menu-row">

                    <div>
                        <div class="menu-name">
                            Chocolate Syrup
                        </div>

                        <div class="menu-category">
                            Ingredient
                        </div>
                    </div>

                    <span class="status available">
                        Available
                    </span>

                </div>

            </div>

        </div>


        <!-- Business Insight -->

        <div class="col-md-6">

            <div class="section-card">

                <div class="section-title">
                    Business Insight
                </div>


                <div class="insight-box">

                    Your menu is currently active and ready for
                    customer orders.

                    <br><br>

                    Keep your most popular items available during
                    peak hours and monitor low-stock ingredients
                    regularly.

                </div>

            </div>

        </div>

    </div>

</div>


<%- include('layout/footer') %>